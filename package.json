{
  "name": "demo-product",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": {
      "types": [
        "./src/*.ts",
        "./src/*.tsx"
      ],
      "node": "./src/*.ts",
      "default": "./src/*"
    },
    "#test/*": "./test/*.ts",
    "#scripts/*": "./scripts/*.ts"
  },
  "exports": {
    "./sdk": "./src/sdk/index.ts",
    "./plane/*": "./src/demo/plane/*.ts",
    "./plane/seed/*": "./src/demo/plane/seed/*.ts"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint",
    "check:reuse": "node scripts/reuse-check.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:without-demo": "node scripts/without-demo.ts",
    "check:bundle": "node scripts/bundle-budget.ts",
    "check:platform": "node scripts/check-platform.ts",
    "sync:platform": "node scripts/sync-platform.ts",
    "check:design": "node scripts/design-spec.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm check:platform && pnpm check:reuse && pnpm check:design && pnpm format:check && pnpm test && pnpm build && pnpm check:bundle"
  },
  "dependencies": {
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@openai/agents": "0.17.2",
    "@pierre/diffs": "1.5.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-router": "1.170.33",
    "agents": "0.26.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cronstrue": "2.59.0",
    "diff": "9.0.0",
    "dom-accessibility-api": "0.7.1",
    "fumadocs-core": "16.15.17",
    "lucide-react": "1.45.0",
    "mdast-util-mdx-jsx": "3.2.0",
    "micromark-extension-mdx-jsx": "3.0.2",
    "micromark-extension-mdx-md": "2.0.0",
    "picomatch": "4.0.7",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "4.12.4",
    "react-reverse-portal": "2.3.0",
    "smol-toml": "1.9.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.6",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.36",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.4",
    "@types/picomatch": "4.0.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.2.0",
    "mdast-util-to-hast": "13.2.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "oxlint-plugin-react-doctor": "0.9.14",
    "remark-parse": "11.0.0",
    "typescript": "7.0.2",
    "unified": "11.0.5",
    "vite": "8.1.5",
    "vitest": "5.0.0",
    "wrangler": "4.130.0"
